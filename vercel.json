{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "app/api/cron/**/route.ts": { "maxDuration": 60 },
    "app/api/creatives/route.ts": { "maxDuration": 60 },
    "app/api/publish/route.ts": { "maxDuration": 60 },
    "app/api/alter/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/morning", "schedule": "0 6 * * *" },
    { "path": "/api/cron/midday", "schedule": "0 13 * * *" }
  ]
}
