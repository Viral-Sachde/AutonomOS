# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDER  (optional - the app runs at $0 with none of this set)
# ─────────────────────────────────────────────────────────────────────────────
# none   = no model calls at all; every agent falls back to its templates
# gemini = Google Gemini free tier
# claude = Anthropic Claude (~$2-4/month at this app's volume)
# Leave unset to auto-pick based on whichever key below is present.
AI_PROVIDER=none

# Claude - https://console.anthropic.com  (minimum top-up is $5)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_EFFORT=medium

# Gemini - https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE  (required in production - database AND image hosting)
# ─────────────────────────────────────────────────────────────────────────────
# Free tier. Create a project at https://supabase.com, then run
# supabase/schema.sql in the SQL editor. Settings > API has both values.
# The service-role key bypasses row-level security: server-side only, never
# prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public storage bucket for rendered artwork. Must stay public - Instagram
# fetches images by URL and presents no credentials.
# This is the bucket's NAME, not a URL. The storage settings page shows an S3
# endpoint next to the bucket list; that is not this value. Leave it unset to
# use "media".
SUPABASE_BUCKET=media

# ─────────────────────────────────────────────────────────────────────────────
# INSTAGRAM  (optional - without it, publishing is review-only)
# ─────────────────────────────────────────────────────────────────────────────
# Requires a Business or Creator account linked to a Facebook Page.
# A personal Instagram account cannot use this API at all.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# CRON PROTECTION  (required in production)
# ─────────────────────────────────────────────────────────────────────────────
# While unset, every /api/cron/* endpoint is publicly callable by anyone.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# Where improvements would be pushed (the GAME repo, not the content repo).
GITHUB_TOKEN=
GITHUB_REPO=Viral-Sachde/avalon-viral

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD AUTH  (required in production)
# ─────────────────────────────────────────────────────────────────────────────
# While any of these is unset the dashboard is OPEN - anyone with the URL can
# approve content and publish to your Instagram.
# Generate the secret with:  openssl rand -hex 32
AUTH_USER=
AUTH_PASSWORD=
AUTH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# POSTING SLOTS  (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Approving a piece schedules it into the next free slot. Comma list of UTC
# HH:MM times. The hourly publish-due job posts whatever has come due.
POST_SLOTS_UTC=13:00,18:00

# Model used only for freedom artwork (Claude). Defaults to claude-opus-5-5.
FREEDOM_MODEL=claude-opus-5-5

# --- AutonomOS orchestrator ---
# off (default): the orchestrator, Sales, Intelligence and Operations agents use
# built-in templates and dummy data, and never spend model credits.
# on: they call the AI_PROVIDER above instead.
ORCHESTRATOR_AI=off
